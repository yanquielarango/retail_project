  "instructions": {
    "example_question_sqls": [
      {
        "id": "01f1b6b5b3e619939808121b543504c9",
        "question": [
          "Show the top 10 customers by net sales."
        ],
        "sql": [
          "SELECT\r\n",
          "  c.customer_id,\r\n",
          "  c.customer_name,\r\n",
          "  c.customer_type,\r\n",
          "  SUM(f.net_sales_amount) AS total_net_sales\r\n",
          "FROM dbr_dev_trial.retail_gold.fact_sales f\r\n",
          "JOIN dbr_dev_trial.retail_gold.dim_customer c\r\n",
          "  ON f.customer_id = c.customer_id\r\n",
          "GROUP BY\r\n",
          "  c.customer_id,\r\n",
          "  c.customer_name,\r\n",
          "  c.customer_type\r\n",
          "ORDER BY\r\n",
          "  total_net_sales DESC\r\n",
          "LIMIT 10;"
        ]
      },
      {
        "id": "01f1b6b70b221438bb2cc46572b11b6f",
        "question": [
          "What are the monthly total net sales?"
        ],
        "sql": [
          "SELECT\r\n",
          "  d.`month_year` AS month,\r\n",
          "  d.`month_year_sort` AS month_sort,\r\n",
          "  SUM(f.`net_sales_amount`) AS total_net_sales\r\n",
          "FROM\r\n",
          "  `dbr_dev_trial`.`retail_gold`.`fact_sales` f\r\n",
          "JOIN\r\n",
          "  `dbr_dev_trial`.`retail_gold`.`dim_date` d\r\n",
          "    ON f.`date_key` = d.`date_key`\r\n",
          "GROUP BY\r\n",
          "  d.`month_year`,\r\n",
          "  d.`month_year_sort`\r\n",
          "ORDER BY\r\n",
          "  d.`month_year_sort`;"
        ]
      },
      {
        "id": "01f1b6b784511e069aca7298f2875b6d",
        "question": [
          "Show net sales by product category"
        ],
        "sql": [
          "SELECT\r\n",
          "  p.`category`,\r\n",
          "  SUM(f.`net_sales_amount`) AS total_net_sales\r\n",
          "FROM\r\n",
          "  `dbr_dev_trial`.`retail_gold`.`fact_sales` f\r\n",
          "JOIN\r\n",
          "  `dbr_dev_trial`.`retail_gold`.`dim_product` p\r\n",
          "    ON f.`product_id` = p.`product_id`\r\n",
          "GROUP BY\r\n",
          "  p.`category`\r\n",
          "ORDER BY\r\n",
          "  total_net_sales DESC;"
        ]
      }
    ],
